      "title": "Saúde da Automação",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Total de registros processados pelo bot no período (exceto pendentes)",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 101,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Total Executados",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND UPPER(status) NOT IN ('PENDENTE', 'AGUARDANDO')\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "% de execuções sem impedimento — mede a saúde do bot. Vermelho < 90%, Amarelo 90–95%, Verde ≥ 95%",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green",  "value": 95 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 102,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Taxa de Sucesso do Bot",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n  COUNT(*) FILTER (WHERE UPPER(status) NOT LIKE '%IMPEDIMENTO%') * 100.0 /\n  NULLIF(COUNT(*) FILTER (WHERE UPPER(status) NOT IN ('PENDENTE', 'AGUARDANDO')), 0),\n  1\n) AS value\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Casos em que o bot travou (IMPEDIMENTO). Diferente de Negado — negado é decisão da operadora, não falha do bot.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 50 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 103,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Impedimentos (falha do bot)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND UPPER(status) LIKE '%IMPEDIMENTO%'\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Casos ainda não processados (estado atual, sem filtro de período)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red",    "value": 200 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 104,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Ainda na Fila (estado atual)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value\nFROM rpa_sync.hos_autorizacoes\nWHERE UPPER(status) IN ('PENDENTE', 'AGUARDANDO')\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "Resultado das Submissões",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Negada = operadora recusou (bot funcionou). Impedimento = bot travou antes de submeter.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Autorizada" },         "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Negada (operadora)" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Impedimento (bot)" },  "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Outros" },             "properties": [{ "id": "color", "value": { "fixedColor": "gray",   "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 201,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["value", "percent"] },
        "pieType": "pie",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Resultado das Submissões",
      "type": "piechart",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) FILTER (WHERE UPPER(status) LIKE '%AUTORIZADO%')                                       AS \"Autorizada\",\n  COUNT(*) FILTER (WHERE UPPER(status) LIKE '%NEGAD%' OR UPPER(status) LIKE '%REPR%')             AS \"Negada (operadora)\",\n  COUNT(*) FILTER (WHERE UPPER(status) LIKE '%IMPEDIMENTO%')                                      AS \"Impedimento (bot)\",\n  COUNT(*) FILTER (WHERE UPPER(status) NOT LIKE '%AUTORIZADO%'\n                     AND UPPER(status) NOT LIKE '%NEGAD%'\n                     AND UPPER(status) NOT LIKE '%REPR%'\n                     AND UPPER(status) NOT LIKE '%IMPEDIMENTO%'\n                     AND UPPER(status) NOT IN ('PENDENTE', 'AGUARDANDO'))                          AS \"Outros\"\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND UPPER(status) NOT IN ('PENDENTE', 'AGUARDANDO')\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Tendência diária — identifica degradação do bot. Impedimentos crescentes indicam problema na automação.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "impedimentos" }, "properties": [{ "id": "color", "value": { "fixedColor": "red",  "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "executados"   }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 6 },
      "id": 202,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "Evolução Diária — Executados vs Impedimentos",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  DATE_TRUNC('day', dt_execucao)                                              AS time,\n  COUNT(*)                                                                    AS executados,\n  COUNT(*) FILTER (WHERE UPPER(status) LIKE '%IMPEDIMENTO%')                  AS impedimentos\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 300,
      "title": "Onde o Bot Trava — Análise de Impedimentos",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "tipo_autorizacao"   }, "properties": [{ "id": "displayName", "value": "Tipo Autorização" }, { "id": "custom.width", "value": 220 }] },
          { "matcher": { "id": "byName", "options": "total_exec"         }, "properties": [{ "id": "displayName", "value": "Total Executados"  }] },
          { "matcher": { "id": "byName", "options": "impedimentos"       }, "properties": [
              { "id": "displayName", "value": "Impedimentos" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } }
          ]},
          { "matcher": { "id": "byName", "options": "taxa_impedimento_pct" }, "properties": [
              { "id": "displayName", "value": "Taxa Imped. %" },
              { "id": "unit",        "value": "percent" },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } }
          ]}
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 301,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Impedimentos" }]
      },
      "title": "Impedimentos por Tipo de Autorização",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  tipo_autorizacao,\n  COUNT(*) FILTER (WHERE UPPER(status) NOT IN ('PENDENTE', 'AGUARDANDO'))             AS total_exec,\n  COUNT(*) FILTER (WHERE UPPER(status) LIKE '%IMPEDIMENTO%')                          AS impedimentos,\n  ROUND(\n    COUNT(*) FILTER (WHERE UPPER(status) LIKE '%IMPEDIMENTO%') * 100.0 /\n    NULLIF(COUNT(*) FILTER (WHERE UPPER(status) NOT IN ('PENDENTE', 'AGUARDANDO')), 0),\n    1\n  )                                                                                   AS taxa_impedimento_pct\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})\nGROUP BY tipo_autorizacao\nORDER BY impedimentos DESC",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Mensagens recorrentes de impedimento — identifica padrões de falha da automação",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "mensagem"    }, "properties": [{ "id": "custom.width", "value": 600 }, { "id": "displayName", "value": "Mensagem de Impedimento" }] },
          { "matcher": { "id": "byName", "options": "ocorrencias" }, "properties": [
              { "id": "displayName", "value": "Ocorrências" },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }, { "color": "red", "value": 30 }] } }
          ]}
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 302,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Ocorrências" }]
      },
      "title": "Top Causas de Impedimento",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  SUBSTRING(mensagem, 1, 150) AS mensagem,\n  COUNT(*)                   AS ocorrencias\nFROM rpa_sync.hos_autorizacoes\nWHERE $__timeFilter(dt_execucao)\nAND UPPER(status) LIKE '%IMPEDIMENTO%'\nAND mensagem IS NOT NULL\nAND mensagem <> ''\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})\nGROUP BY SUBSTRING(mensagem, 1, 150)\nORDER BY ocorrencias DESC\nLIMIT 20",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 400,
      "title": "Fila de Pendentes — Casos Validados pelo Bot",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Total de casos que o bot validou e colocou na fila (estado atual)",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 32 },
      "id": 401,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Validados pelo Bot",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value\nFROM rpa_sync.rpa_hos_autorizacoes_pendentes\nWHERE tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Casos em que a operadora já retornou uma resposta (aprovado ou reprovado)",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 32 },
      "id": 402,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Com Resposta da Operadora",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value\nFROM rpa_sync.rpa_hos_autorizacoes_pendentes\nWHERE (\n  UPPER(status_operadora) LIKE '%APRO%' OR UPPER(status_operadora) LIKE '%AUTO%'\n  OR UPPER(status_operadora) LIKE '%REPRO%' OR UPPER(status_operadora) LIKE '%NEGAD%'\n)\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
      "description": "Casos submetidos pelo bot que ainda aguardam resposta da operadora",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red",    "value": 200 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 32 },
      "id": 403,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Aguardando Operadora",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "rpa-sync-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value\nFROM rpa_sync.rpa_hos_autorizacoes_pendentes\nWHERE UPPER(status) IN ('PENDENTE', 'AGUARDANDO')\nAND tipo_autorizacao IN (${tipo_autorizacao:singlequote})",
