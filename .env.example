# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=TROQUE_AQUI

# Alertas
N8N_GRAFANA_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/.../message?zapikey=...
GRAFANA_ALERT_EMAIL=ti@austa.com.br,oncall@austa.com.br

# SMTP (opcional)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.austa.com.br:587
GF_SMTP_USER=alertas@austa.com.br
GF_SMTP_FROM_ADDRESS=alertas@austa.com.br
GF_SMTP_FROM_NAME=AUSTA Monitoramento
GF_SMTP_PASSWORD=SENHA_AQUI

# ── PostgreSQL próprio do monitoramento ───────────────────────────────────────
# Sobe com o compose — não depende do MAEZO
AUSTA_PG_PASSWORD=TROQUE_AQUI

# ── PostgreSQL do MAEZO (opcional) ───────────────────────────────────────────
# Necessário apenas para os dashboards BPMN (maezo-instance-detail, maezo-rc-ops)
# que leem tabelas internas do CIB Seven. Se o MAEZO estiver fora, só esses
# dashboards ficam sem dados — o restante do monitoramento funciona normalmente.
MAEZO_PG_PASSWORD=maestro_local

# ── Oracle (Tasy / ROBO_RPA) ─────────────────────────────────────────────────
ORACLE_USER=robo_rpa
ORACLE_PASSWORD=SENHA_AQUI
ORACLE_HOST=oracle-host-ou-ip
ORACLE_PORT=1521
ORACLE_SERVICE=TASY

# ── Oracle Sync ───────────────────────────────────────────────────────────────
SYNC_INTERVAL=300
BATCH_SIZE=500
