# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=TROQUE_AQUI

# Alertas
N8N_GRAFANA_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/.../message?zapikey=...
GRAFANA_ALERT_EMAIL=ti@austa.com.br,oncall@austa.com.br

# SMTP (opcional)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.austa.com.br:587
GF_SMTP_FROM=alertas@austa.com.br

# ── PostgreSQL (MAEZO) ────────────────────────────────────────────────────────
PG_HOST=postgres       # container name na rede maestro_local
PG_PORT=5432
PG_DB=cibseven
PG_USER=maestro
PG_PASSWORD=maestro_local

# ── Oracle (Tasy / ROBO_RPA) ─────────────────────────────────────────────────
ORACLE_USER=robo_rpa
ORACLE_PASSWORD=SENHA_AQUI
ORACLE_HOST=oracle-host-ou-ip
ORACLE_PORT=1521
ORACLE_SERVICE=TASY

# ── Oracle Sync ───────────────────────────────────────────────────────────────
SYNC_INTERVAL=300     # segundos entre ciclos (padrão: 5min)
BATCH_SIZE=500
